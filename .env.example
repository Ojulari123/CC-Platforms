# Copy to `.env` (git-ignored) and edit if you need non-default creds for the
# LOCAL sandbox Postgres. Nothing to do with Neon or prod — services set their
# own DATABASE_URL in their own .env files.
#
# CC_ prefix isolates from any global POSTGRES_USER on the machine.

CC_POSTGRES_USER=crescent
CC_POSTGRES_PASSWORD=crescent
CC_POSTGRES_DB=crescent

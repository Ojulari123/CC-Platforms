# Database (Pulse owns its own; never identity's)
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/pulse

# Identity trust
    # - Where to fetch identity's public keys to verify tokens. The signing key never leaves identity. 
    # - JWT_ISSUER must match identity's exactly.
IDENTITY_JWKS_URL=http://identity:8000/.well-known/jwks.json
JWT_ISSUER=cyphercrescent-identity
JWKS_TTL_SECONDS=3600

# Service-to-service auth (Pulse -> identity, for resolving approver emails on submit).
# IDENTITY_API_URL is identity's internal base URL. The secret is the client_secret issued
# to the "pulse" service client; leave blank in dev and email resolution is skipped.
IDENTITY_API_URL=http://identity:8000
PULSE_SERVICE_CLIENT_ID=pulse
PULSE_SERVICE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate limiting
# Limits on the routes that cost something: /reports/generate (10/hour — one OpenAI
# call each), /reports (30/min), /github/connect (10/min), /github/oauth/callback
# (20/min), /github/sync (5/min). In-memory store; leave on outside of tests.
# Authenticated routes are limited per user, the OAuth callback per client address.
RATE_LIMIT_ENABLED=true

# DANGER — only set this true if Pulse actually sits behind a reverse proxy
# or load balancer that YOU run. X-Forwarded-For is just a request header: anyone
# can send one. Trusting it while exposed directly lets a caller send a different
# value on every request and bypass every address-based limit entirely — strictly
# worse than not reading the header at all. Leave false on localhost and anywhere
# the app is reachable without going through your proxy.
TRUST_PROXY_HEADERS=false
# How many proxies of yours are in front of Pulse. Each appends the address it
# saw, so we take the entry this far from the RIGHT of X-Forwarded-For; everything
# left of it was supplied by the caller. Set it too high and you read a
# caller-controlled entry — count the hops, don't guess. Minimum 1; 0 or negative
# is refused at startup, since it would read the caller-supplied end of the header.
TRUSTED_PROXY_COUNT=1

# Background jobs (Celery + Redis) 
REDIS_URL=redis://localhost:6379/0
SYNC_HOUR_UTC=2

# GitHub OAuth
# The redirect URI points at Pulse, not the frontend, because only this service holds
# the client secret. Once the code is exchanged the callback sends the browser on to
# FRONTEND_URL (bottom of this file) with a result code, so set both. This value must
# match the callback URL registered on the GitHub OAuth app exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8002/github/oauth/callback
# What we ask GitHub for when a user connects their account. The default, read:user,
# grants NO access to repository contents — against a private repo the sync succeeds
# and returns nothing rather than failing, so it looks like there was no activity.
# Add the repo scope to sync private repositories: GITHUB_OAUTH_SCOPES=read:user,repo
# Changing this only affects accounts connected AFTER the change; anyone already
# connected keeps the scopes they granted until they reconnect.
GITHUB_OAUTH_SCOPES=read:user
# Override these two only for GitHub Enterprise Server; defaults are github.com.
GITHUB_OAUTH_BASE=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN_ENC_KEY=
# Which repositories to sync, comma separated as owner/name. This allowlist is the
# only way repos are discovered — nothing is picked up automatically.
GITHUB_REPOS=

# LLM (weekly report generation)
# OPENAI_API_KEY works too — either variable populates the same setting.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_OUTPUT_TOKENS=1000

# Outbound email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=
# Where the Pulse frontend is served. Used for report links in emails and as the
# landing place after the GitHub OAuth callback.
FRONTEND_URL=http://localhost:3000

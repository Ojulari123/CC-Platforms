# Deploying rather than running locally? DEPLOY.md lists which of these go in
# render.yaml, which are typed into the Render dashboard, and what each one breaks.

# Database (Pulse owns its own; never identity's)
# A managed provider (Render, Heroku, Neon's copy button) hands you a URL starting
# postgresql:// or postgres://. Either is accepted: config.py rewrites the scheme to
# postgresql+psycopg:// so SQLAlchemy picks the psycopg 3 driver we actually ship,
# instead of looking for psycopg2 and failing to boot. Write it either way.
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/pulse

# Identity trust
    # - Where to fetch identity's public keys to verify tokens. The signing key never leaves identity. 
    # - JWT_ISSUER must match identity's exactly.
IDENTITY_JWKS_URL=http://identity:8000/.well-known/jwks.json
JWT_ISSUER=cyphercrescent-identity
JWKS_TTL_SECONDS=3600

# Service-to-service auth (Pulse -> identity, for resolving approver emails on submit).
# IDENTITY_API_URL is identity's internal base URL. The secret is the client_secret issued
# to the "pulse" service client; leave blank in dev and email resolution is skipped.
IDENTITY_API_URL=http://identity:8000
PULSE_SERVICE_CLIENT_ID=pulse
PULSE_SERVICE_CLIENT_SECRET=

# CORS
# Forge 3000, Pulse's own frontend 3001, identity's admin UI 3002 — identity's product
# picker reads live counts from Pulse, so a missing 3002 shows up as a browser CORS
# error and a blank stat line, not a 4xx.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate limiting
# Limits on the routes that cost something: /reports/generate (10/hour — one OpenAI
# call each), /reports (30/min), /github/connect (10/min), /github/oauth/callback
# (20/min), /github/sync (5/min). In-memory store; leave on outside of tests.
# Authenticated routes are limited per user, the OAuth callback per client address.
RATE_LIMIT_ENABLED=true

# DANGER — only set this true if Pulse actually sits behind a reverse proxy
# or load balancer that YOU run. X-Forwarded-For is just a request header: anyone
# can send one. Trusting it while exposed directly lets a caller send a different
# value on every request and bypass every address-based limit entirely — strictly
# worse than not reading the header at all. Leave false on localhost and anywhere
# the app is reachable without going through your proxy.
TRUST_PROXY_HEADERS=false
# How many proxies of yours are in front of Pulse. Each appends the address it
# saw, so we take the entry this far from the RIGHT of X-Forwarded-For; everything
# left of it was supplied by the caller. Set it too high and you read a
# caller-controlled entry — count the hops, don't guess. Minimum 1; 0 or negative
# is refused at startup, since it would read the caller-supplied end of the header.
TRUSTED_PROXY_COUNT=1

# Background jobs (Celery + Redis) 
REDIS_URL=redis://localhost:6379/0
SYNC_HOUR_UTC=2

# GitHub OAuth
# The redirect URI points at Pulse, not the frontend, because only this service holds
# the client secret. Once the code is exchanged the callback sends the browser on to
# FRONTEND_URL (bottom of this file) with a result code, so set both. This value must
# match the callback URL registered on the GitHub OAuth app exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8002/github/oauth/callback
# What we ask GitHub for when a user connects their account. read:user identifies the
# person; repo is what grants access to repository contents. Drop repo and a private
# repo syncs successfully with nothing in it, which reads as no activity rather than
# as a permission problem.
# Changing this only affects accounts connected AFTER the change; anyone already
# connected keeps the scopes they granted until they reconnect. GET /chat/repos/github-status
# reports reconnect_required for those accounts, and POST /github/reconnect starts the
# reconnect.
GITHUB_OAUTH_SCOPES=read:user,repo
# Override these two only for GitHub Enterprise Server; defaults are github.com.
GITHUB_OAUTH_BASE=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN_ENC_KEY=
# Which repositories to sync, comma separated as owner/name. This allowlist is the
# only way repos are discovered — nothing is picked up automatically.
GITHUB_REPOS=

# How long having authored a commit, PR, issue or review in a repository keeps that
# repository readable. Being its lead/deputy or a member of its department is checked
# live off the access token and needs no window; authorship is historical and would
# otherwise grant read on an old team's repositories forever. Lower it to cut the
# window an internal department move leaves open.
REPO_VISIBILITY_ACTIVITY_DAYS=90
# How far back before the last-synced cursor each pass re-asks GitHub for commits.
# GitHub's `since` filters on COMMIT date, not push time, so work committed before the
# cursor and pushed after it (offline for a week, an old branch merged, a force-push)
# sits behind the cursor and would never be fetched — on that pass or any pass after it.
# The window is the fix. Too small and that work is still lost; too large and every pass
# re-reads commits it already holds. 7 days covers a normal offline stretch and costs
# about one extra request per repo per pass, because the re-read rows upsert by
# (repo, sha) instead of duplicating. Repos with no push since the window starts are
# skipped outright, which is what pays for it. 0 disables the window.
GITHUB_SYNC_OVERLAP_MINUTES=10080
# Also sync commits on branches other than the default one. Off, only the default
# branch is pulled and work on a feature branch is invisible until it merges. On, each
# pass costs one call to list branches, plus one call per branch whose head commit we
# don't already hold — merged and abandoned branches cost nothing.
GITHUB_SYNC_BRANCHES=true
# Ceiling on how many branches one pass will pull per repo, so a repo carrying hundreds
# of them can't spend the shared hourly GitHub quota. Anything over the cap waits for
# the next pass.
GITHUB_SYNC_MAX_BRANCHES=25

# LLM (weekly report generation)
# OPENAI_API_KEY works too — either variable populates the same setting.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_OUTPUT_TOKENS=1000

# Which provider the newer AI surfaces (journal rollups, chat answers) generate with.
# auto  — Anthropic if ANTHROPIC_API_KEY is set, otherwise the OpenAI LLM_API_KEY above.
#         A server with only an OpenAI key still gets working rollups and chat.
# anthropic / openai — pinned. A pinned provider with no key is an error, not a
#         fallback: pinning is usually about which bill the tokens land on.
# Weekly report generation is unaffected either way; it is always OpenAI.
AI_PROVIDER=auto

# Anthropic (preferred for journal rollups and chat when a key is present)
# Weekly reports stay on the OpenAI settings above; this key powers the newer AI
# surfaces only, so the two can be billed and rotated separately. CLAUDE_API_KEY works
# too — either variable populates the same setting. Leave blank and those surfaces fall
# back to OpenAI; leave BOTH blank and they answer 502 while everything else runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=60.0

# Caps the length of a generated answer (journal rollups, chat) for whichever provider
# AI_PROVIDER resolves to — OpenAI included — which is why it is no longer named after
# Anthropic. The old name ANTHROPIC_MAX_OUTPUT_TOKENS still sets the same value, so a
# server already setting it keeps working; new setups should use AI_MAX_OUTPUT_TOKENS.
# (ANTHROPIC_TIMEOUT_SECONDS above really is Anthropic-only — OpenAI has its own
# LLM_TIMEOUT_SECONDS — so it keeps its name.)
AI_MAX_OUTPUT_TOKENS=1500

# Repo index + embeddings (the chat assistant's retrieval)
# Embeddings run on OpenAI (Anthropic has no embeddings API), so they spend LLM_API_KEY
# above, not ANTHROPIC_API_KEY. EMBEDDING_DIMENSIONS must match the width of the vector
# column created by migration 0008 (1536, text-embedding-3-small's width) — Pulse refuses
# to start if they disagree, because the column width is fixed by the schema and no
# setting can resize it. Changing the model to one with a different width needs a
# migration, not just this line.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Ceilings on one ingest. A repo bigger than these is indexed as far as the cap allows
# and the reason is written to the repo's `detail`, so a partial index is never silent.
# INDEX_MAX_FILES caps files read; INDEX_MAX_FILE_BYTES skips single blobs above it
# (generated bundles, checked-in data); INDEX_EMBED_BATCH_SIZE is how many chunks go to
# OpenAI per request.
INDEX_MAX_FILES=3000
INDEX_MAX_FILE_BYTES=200000
# Files are split into overlapping line windows. The overlap is what keeps a function
# that straddles a boundary retrievable from either side; set it to 0 and answers start
# citing halves of things.
INDEX_CHUNK_LINES=60
INDEX_CHUNK_OVERLAP=10
INDEX_EMBED_BATCH_SIZE=96
# Blobs are fetched concurrently, in batches that are embedded and committed as they go.
# INDEX_FETCH_CONCURRENCY is how many GitHub requests are in flight at once (1 disables
# concurrency); INDEX_BATCH_FILES is how many files each committed batch holds, which is
# also how much work a failed run has to redo when it is retried.
INDEX_FETCH_CONCURRENCY=8
INDEX_BATCH_FILES=50
# How many retrieved chunks one chat answer is grounded in, taken across every repository
# in scope rather than per repository. Higher costs more tokens per question and, past
# the context cap in services/chat.py, starts truncating the chunks it sends.
CHAT_TOP_K=12
# Ceiling on how many citations come back with one answer. Retrieval still searches
# CHAT_TOP_K chunks; this caps what is shown, and only files the answer actually names
# are cited. Raising it gives the reader more to check, not a better answer.
CHAT_MAX_CITATIONS=6
# Ceiling on AI spend per user per UTC day, counted across every surface that writes to
# the token ledger (reports, journal rollups, embeddings). Past it the request is refused
# with a 429 that says when it resets. 0 means unlimited.
#
# This is the DEFAULT, not the last word. A platform admin, a department admin and a user
# can each store an allowance through /settings/credentials/budgets, resolved user then
# department then platform then this value. Raising one above what it inherits is only
# allowed where a non-platform key is paying for the spend; lowering one is always
# allowed. Leave this as the figure a brand new tenant should start on.
#
# The check counts what a call is about to cost before making it, using a measured
# approximation biased high (see services/llm_budget.py). Budgets therefore stop a little
# before the nominal figure rather than a little after it.
LLM_DAILY_TOKEN_CAP_PER_USER=200000

# Outbound email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=
# Where the Pulse frontend is served. Used for report links in emails and as the
# landing place after the GitHub OAuth callback.
FRONTEND_URL=http://localhost:3000

# Copy to `.env` (git-ignored) and fill in before running.
# Under docker-compose, DATABASE_URL is overridden so Pulse talks to the sandbox
# Postgres. This file's DATABASE_URL is only used running Pulse standalone.

# ── Database (Pulse owns its own; never identity's) ───────────────────
# Local: postgresql+psycopg://crescent:crescent@localhost:5432/pulse
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/pulse

# ── Identity trust ────────────────────────────────────────────────────
# Where to fetch identity's public keys to verify tokens. The signing key
# never leaves identity. JWT_ISSUER must match identity's exactly.
IDENTITY_JWKS_URL=http://identity:8000/.well-known/jwks.json
JWT_ISSUER=cyphercrescent-identity
JWKS_TTL_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Background jobs (Celery + Redis) ──────────────────────────────────
# Redis is the broker + result backend. Under docker-compose this is
# overridden to the in-cluster redis. SYNC_HOUR_UTC = hour the daily
# GitHub sync fires (0-23, UTC).
REDIS_URL=redis://localhost:6379/0
SYNC_HOUR_UTC=2

# ── GitHub OAuth + sync (Week 3) ──────────────────────────────────────
# From your GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# The redirect must match the app's "Authorization callback URL" exactly.
# GITHUB_TOKEN_ENC_KEY encrypts stored tokens at rest — generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GITHUB_REPOS is the owner/name allowlist to sync (comma-separated).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8002/github/oauth/callback
GITHUB_TOKEN_ENC_KEY=
GITHUB_REPOS=

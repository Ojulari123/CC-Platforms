# Copy to `.env` (git-ignored) and fill in before running.
# Under docker-compose, DATABASE_URL is overridden so Pulse talks to the sandbox
# Postgres. This file's DATABASE_URL is only used running Pulse standalone.

# ── Database (Pulse owns its own; never identity's) ───────────────────
# Local: postgresql+psycopg://crescent:crescent@localhost:5432/pulse
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/pulse

# ── Identity trust ────────────────────────────────────────────────────
# Where to fetch identity's public keys to verify tokens. The signing key
# never leaves identity. JWT_ISSUER must match identity's exactly.
IDENTITY_JWKS_URL=http://identity:8000/.well-known/jwks.json
JWT_ISSUER=cyphercrescent-identity
JWKS_TTL_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

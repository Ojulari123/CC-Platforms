# Deploying rather than running locally? DEPLOY.md lists which of these go in
# render.yaml, which are typed into the Render dashboard, and what each one breaks.

# Database (Forge owns its own; never identity's or Pulse's)
# A managed provider (Render, Heroku, Neon's copy button) hands you a URL starting
# postgresql:// or postgres://. Either is accepted: config.py rewrites the scheme to
# postgresql+psycopg:// so SQLAlchemy picks the psycopg 3 driver we actually ship,
# instead of looking for psycopg2 and failing to boot. Write it either way.
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/forge

# Identity trust
    # - Where to fetch identity's public keys to verify tokens. The signing key never leaves identity.
    # - JWT_ISSUER must match identity's exactly.
IDENTITY_JWKS_URL=http://identity:8000/.well-known/jwks.json
JWT_ISSUER=cyphercrescent-identity
JWKS_TTL_SECONDS=3600

# Service-to-service auth (Forge -> identity, for checking a session is still alive).
    # - IDENTITY_API_URL is identity's internal base URL.
    # - The secret is the client_secret issued to the "forge" service client; it must match
    #   identity's FORGE_CLIENT_SECRET exactly.
    # - Leaving it blank DISABLES service-to-service auth: POST /oauth/token returns 401
    #   and Forge can call no /internal/* endpoint.
    # - The "forge" client holds only the tokens:verify scope; the user lookups
    #   (/internal/users/profiles, /internal/users/emails) are refused with 403.
IDENTITY_API_URL=http://identity:8000
FORGE_SERVICE_CLIENT_ID=forge
FORGE_SERVICE_CLIENT_SECRET=

# CORS
# Forge's own frontend 3000, plus identity's admin UI 3002 — identity's product picker
# reads live counts from Forge, so a missing 3002 shows up as a browser CORS error and a
# blank stat line, not a 4xx.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Rate limiting
    # - Counters live in Redis so every worker/replica shares one tally. If Redis can't be
    #   reached Forge logs a warning and falls back to per-process in-memory counters.
    # - Set RATE_LIMIT_ENABLED=false to turn limiting off entirely (tests do this).
    # - Every limited route is authenticated, so counters are keyed per user (the
    #   bearer token is verified before its id is used), falling back to the
    #   client address when there is no usable token.
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# DANGER — only set this true if Forge actually sits behind a reverse proxy or
# load balancer that YOU run. X-Forwarded-For is just a request header: anyone
# can send one. Trusting it while exposed directly lets a caller send a different
# value on every request and bypass every address-based limit entirely — strictly
# worse than not reading the header at all. Leave false on localhost and anywhere
# the app is reachable without going through your proxy.
TRUST_PROXY_HEADERS=false
# How many proxies of yours are in front of Forge. Each appends the address it
# saw, so we take the entry this far from the RIGHT of X-Forwarded-For; everything
# left of it was supplied by the caller. Set it too high and you read a
# caller-controlled entry — count the hops, don't guess. Minimum 1; 0 or negative
# is refused at startup, since it would read the caller-supplied end of the header.
TRUSTED_PROXY_COUNT=1

# Datasets
DATASET_PREVIEW_ROWS=10
MAX_UPLOAD_MB=5

# Copy to `.env` (git-ignored) and fill in real values before running.
# Deploying rather than running locally? DEPLOY.md lists which of these go in
# render.yaml, which are typed into the Render dashboard, and what each one breaks.
# Under docker-compose, DATABASE_URL is overridden so identity talks to the sandbox Postgres.
# This file's DATABASE_URL is only used when running identity standalone (uvicorn from the venv).

# ── Database ──────────────────────────────────────────────────────────
# A managed provider (Render, Heroku, Neon's copy button) hands you a URL starting
# postgresql:// or postgres://. Either is accepted: config.py rewrites the scheme to
# postgresql+psycopg:// so SQLAlchemy picks the psycopg 3 driver we actually ship,
# instead of looking for psycopg2 and failing to boot. Write it either way.
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/identity

# ── JWT signing (RS256) ───────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Where the public halves of RETIRED signing keys live. Every *.pem in here is
# published at /.well-known/jwks.json alongside the active key, so a token minted
# before a rotation keeps verifying until it expires instead of everyone being
# signed out the moment the key changes. Nothing is ever SIGNED with these.
# Populated by scripts/rotate-identity-keys.sh; a missing directory just means
# "no retired keys", which is the normal single-keypair setup.
JWT_RETIRED_PUBLIC_KEYS_DIR=./keys/retired
JWT_ALGORITHM=RS256
JWT_ISSUER=cyphercrescent-identity
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Life of a service-to-service token minted by POST /oauth/token. Shorter than a
# user access token — a service can always re-authenticate with its credentials.
SERVICE_TOKEN_EXPIRE_MINUTES=10

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call identity from a browser.
# Every product's frontend needs listing: Forge 3000, Pulse 3001, identity's own
# admin UI 3002. A missing origin fails as a browser CORS error, not a 4xx.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Rate limiting ─────────────────────────────────────────────────────
# Limits on /auth/* (5/min register, 10/min login, 30/min refresh,
# 5/min change-password). Leave on outside of tests.
# Routes with no caller yet (login, signup, register, refresh, forgot-password,
# oauth/token) are limited per client address; authenticated ones per user.
RATE_LIMIT_ENABLED=true
# Counters live here so every worker and replica shares one bucket. Unreachable or
# blank falls back to per-process in-memory counting with a warning, never a crash.
REDIS_URL=redis://localhost:6379/0

# DANGER — only set this true if identity actually sits behind a reverse proxy
# or load balancer that YOU run. X-Forwarded-For is just a request header: anyone
# can send one. Trusting it while exposed directly lets a caller send a different
# value on every request and bypass every address-based limit entirely — strictly
# worse than not reading the header at all. Leave false on localhost and anywhere
# the app is reachable without going through your proxy.
TRUST_PROXY_HEADERS=false
# How many proxies of yours are in front of identity. Each appends the address it
# saw, so we take the entry this far from the RIGHT of X-Forwarded-For; everything
# left of it was supplied by the caller. Set it too high and you read a
# caller-controlled entry — count the hops, don't guess. Minimum 1; 0 or negative
# is refused at startup, since it would read the caller-supplied end of the header.
TRUSTED_PROXY_COUNT=1

# ── Email (Brevo) ─────────────────────────────────────────────────────
# Needed for the invite flow. Leave blank to run without email — invite
# creation will return 503 until both are set.
BREVO_API_KEY=
EMAIL_FROM=

# ── Invites & password reset ──────────────────────────────────────────
# Identity's OWN frontend (dev port 3002; Forge is 3000 and Pulse is 3001), because
# two of the four links below only exist in it:
#   Invite links point at:       {FRONTEND_URL}/invites/accept?token=...
#   Reset links point at:        {FRONTEND_URL}/reset-password?token=...
#   Email-change links point at: {FRONTEND_URL}/confirm-email-change?token=...
#   Account notices point at:    {FRONTEND_URL}/account
FRONTEND_URL=http://localhost:3002
INVITE_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Self-signup ───────────────────────────────────────────────────────
# Which email domains may create their own account via POST /auth/signup.
# Empty = allow ANY domain, and identity warns on startup when it is. Comma-separated
# for more than one. Existing accounts on other domains keep working; this only gates
# new self-signups.
SIGNUP_ALLOWED_DOMAINS=cyphercrescent.org,cyphercrescent.com

# ── Pulse service client (service-to-service auth) ────────────────────
# Credentials for the "pulse" OAuth2 client-credentials client, seeded on startup.
# Leaving PULSE_CLIENT_SECRET blank DISABLES service-to-service auth: the seed
# silently no-ops, so POST /oauth/token returns 401 and both /internal/users/*
# endpoints are unreachable with no error explaining why. Set it to the same value
# as Pulse's PULSE_SERVICE_CLIENT_SECRET.
PULSE_CLIENT_ID=pulse
PULSE_CLIENT_SECRET=

# ── Forge service client (service-to-service auth) ────────────────────
# Credentials for the "forge" client, seeded on startup the same way. Forge gets
# ONLY the tokens:verify scope — it renders no names or addresses, so it can check
# whether a session is still alive and nothing else.
# Leaving FORGE_CLIENT_SECRET blank DISABLES service-to-service auth for Forge: the
# seed silently no-ops, so POST /oauth/token returns 401 with no error explaining
# why. Set it to the same value as Forge's FORGE_SERVICE_CLIENT_SECRET.
# Seeding happens at startup only — restart identity after changing these.
FORGE_CLIENT_ID=forge
FORGE_CLIENT_SECRET=

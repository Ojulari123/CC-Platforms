# Copy to `.env` (git-ignored) and fill in real values before running.
# Under docker-compose, DATABASE_URL is overridden so identity talks to the
# sandbox Postgres. This file's DATABASE_URL is only used when running identity
# standalone (uvicorn from the venv).

# ── Database ──────────────────────────────────────────────────────────
# Neon: postgresql+psycopg://<user>:<pass>@<host>/<db>?sslmode=require
# Local: postgresql+psycopg://crescent:crescent@localhost:5432/identity
# The `+psycopg` prefix is REQUIRED — SQLAlchemy needs it to pick psycopg 3.
DATABASE_URL=postgresql+psycopg://crescent:crescent@localhost:5432/identity

# ── JWT signing (RS256) ───────────────────────────────────────────────
# Identity holds the private key. Only the public key ever leaves (via
# /.well-known/jwks.json). Generate with `./scripts/generate-identity-keys.sh`.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=cyphercrescent-identity
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call identity from a browser.
CORS_ORIGINS=http://localhost:3000

# ── Email (Brevo — tentative, pending supervisor sign-off) ────────────
# BREVO_API_KEY=
# EMAIL_FROM=noreply@cyphercrescent.com
